.env
.env.*
*.env
secrets.yaml
config_local.yaml
!.env.example

# ---------------------------------------------------------------------------
# Model artifacts and large binaries
#   Exception: the small LoRA adapter under deploy/ is committed on purpose
#   so the Hugging Face Space can load it without Processed_Data/.
# ---------------------------------------------------------------------------
models/
*.npy
*.npz
*.faiss
*.bin
*.pt
*.pth
*.ckpt
*.pkl
*.h5
*.hdf5
*.onnx
*.onnx.data
*.safetensors
*.zip
!deploy/
!deploy/**
!deploy/lora_adapter/*.safetensors

