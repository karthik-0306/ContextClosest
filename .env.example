# Copy this file to `.env` and fill in your values. Never commit `.env`.

# ── Qdrant Cloud (required for the API, the streaming indexer and Modal) ──────
QDRANT_URL="https://<your-cluster-id>.<region>.aws.cloud.qdrant.io"
QDRANT_API_KEY="<your-qdrant-api-key>"

# ── AWS S3: public product images ─────────────────────────────────────────────
# Used by scripts/upload_to_s3.py, scripts/cloud_reindex.py, Spark's image_url
# and `kafka_producer.py --upload-images`.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME="processed-abo-dataset"
AWS_REGION="eu-north-1"

# ── Optional: Redis (defaults to a local Redis on 127.0.0.1:6379) ─────────────
# Either a URL (use rediss:// for TLS, e.g. Upstash) ...
# REDIS_URL="rediss://default:<password>@<host>:6379"
# ... or host / port / password:
# REDIS_HOST="127.0.0.1"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""

# ── Optional: Kafka broker (default localhost:9092; empty = telemetry off) ────
# KAFKA_BOOTSTRAP="localhost:9092"

# ── Optional: PyTorch CPU threads (default: min(4, available CPUs)) ───────────
# TORCH_NUM_THREADS="4"
